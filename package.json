{
  "name": "raccoon-royale",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web-client",
    "shared-schemas",
    "near-bridge"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev -w web-client",
    "schemas:generate": "npm run generate -w shared-schemas",
    "schemas:check": "npm run check -w shared-schemas",
    "test": "npm test -w shared-schemas && npm test -w web-client",
    "build": "npm run schemas:check && npm run build -w web-client",
    "test:backend": "cd backend-java && ./mvnw test",
    "test:browser": "playwright test",
    "portraits:render": "node scripts/render-portraits.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
