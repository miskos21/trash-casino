# Copy to .env for Docker Compose. Never commit actual credentials.
POSTGRES_DB=raccoon_royale
POSTGRES_USER=raccoon
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
SERVER_PORT=8080
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Vite reads web-client/.env.local; use VITE_BACKEND_TARGET for its dev proxy.
# Browser requests use same-origin /api and /ws.
VITE_BACKEND_TARGET=http://localhost:8080
# NEAR Testnet only. TRASH has no real-world value. Contracts exist in blockchain/,
# but the backend and bridge do not read these values yet; no NEAR calls or LLM requests.
# Account IDs come from blockchain/deployments/testnet.json after scripts/deploy.sh.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
TRASH_TOKEN_CONTRACT_ID=
TRASH_CASINO_CONTRACT_ID=
# Settler: restricted function-call key (create_game / settle_game / cancel_game only).
NEAR_SETTLEMENT_ACCOUNT_ID=
NEAR_SETTLEMENT_PRIVATE_KEY=
# NPC agents: restricted function-call keys (agent_pay / agent_join_game only).
# Server-side only. Never pass these to an LLM or the browser.
NEAR_AGENT_DON_ACCOUNT_ID=
NEAR_AGENT_DON_PRIVATE_KEY=
NEAR_AGENT_FOXY_ACCOUNT_ID=
NEAR_AGENT_FOXY_PRIVATE_KEY=
LLM_API_KEY=
